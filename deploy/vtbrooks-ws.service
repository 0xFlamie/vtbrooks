[Unit]
Description=vtbrooks OKX spot WebSocket kline buffer
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/opt/vtbrooks
ExecStart=/opt/vtbrooks/venv/bin/python -u ws_kline.py --exchange okx --symbols ETHUSDC --intervals 5m,15m,4h,1d --snapshot /opt/vtbrooks/kline_snapshot.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
